# ════════════════════════════════════════════════════════════════
#  iCity GED — réglages du serveur
#  Copiez ce fichier en « .env » et complétez-le. Le .env n'est
#  jamais envoyé dans Git : il contient des secrets.
# ════════════════════════════════════════════════════════════════

NODE_ENV=development
TZ=Africa/Casablanca
PORT=8080

# Adresse utilisée dans les liens des e-mails. En développement, les
# écrans sont servis par Vite sur le port 5173.
APP_URL=http://127.0.0.1:5173
ORIGINES_AUTORISEES=http://127.0.0.1:8080,http://127.0.0.1:5173

# PostgreSQL. Un rôle dédié à l'application, pas « postgres ».
DATABASE_URL=postgresql://icity:MOT_DE_PASSE@127.0.0.1:5432/icity_ged

# Clé de chiffrement (32 octets en base64). Générez-la avec :
#   npm run cle -w serveur
CLE_APP=

# Outils externes. Laisser vide pour utiliser le PATH.
POPPLER_BIN=C:\Users\LENOVO\AppData\Local\Programs\MiKTeX\miktex\bin\x64
TESSERACT_BIN=C:\Program Files\Tesseract-OCR
# Les langues fra/ara ne tiennent pas sous Program Files (protege en
# ecriture) : elles vivent dans un dossier a soi.
TESSDATA_PREFIX=%LOCALAPPDATA%\icity-tessdata
OCR_LANGUES=fra+ara+eng

# Courriel sortant : Mailpit en développement (interface sur http://127.0.0.1:8025)
MAIL_HOTE=127.0.0.1
MAIL_PORT=1025
MAIL_EXPEDITEUR="iCity GED <ged@icity.local>"

# Ancienne installation Paperless, pour l import (phase 10).
PAPERLESS_URL=http://localhost:8000
PAPERLESS_UTILISATEUR=admin
PAPERLESS_MOT_DE_PASSE=

# Premier administrateur, créé par « npm run db:seed ».
# Sans ADMIN_MOT_DE_PASSE, un mot de passe provisoire est tiré et affiché.
ADMIN_NOM=
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=
